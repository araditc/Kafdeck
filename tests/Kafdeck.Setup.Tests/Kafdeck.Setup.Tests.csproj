<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <AssemblyName>Kafdeck.Setup.Tests</AssemblyName>
    <DefineConstants>$(DefineConstants);SETUP_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio"><PrivateAssets>all</PrivateAssets></PackageReference>
    <Compile Include="../../deploy/windows/gui/Language.cs" Link="Language.cs" />
    <Compile Include="../../deploy/windows/gui/SetupMedia.cs" Link="SetupMedia.cs" />
    <Compile Include="../../deploy/windows/gui/Program.cs" Link="Wizard.cs" />
    <EmbeddedResource Include="$(SetupAssets)/metadata.json" LogicalName="Setup.metadata.json" Condition="Exists('$(SetupAssets)/metadata.json')" />
    <EmbeddedResource Include="$(SetupAssets)/agreement.txt" LogicalName="Setup.agreement.txt" Condition="Exists('$(SetupAssets)/agreement.txt')" />
    <EmbeddedResource Include="$(SetupAssets)/notices.txt" LogicalName="Setup.notices.txt" Condition="Exists('$(SetupAssets)/notices.txt')" />
    <EmbeddedResource Include="$(SetupAssets)/logo.png" LogicalName="Setup.logo.png" Condition="Exists('$(SetupAssets)/logo.png')" />
  </ItemGroup>
</Project>
